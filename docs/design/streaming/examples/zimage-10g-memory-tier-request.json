{
  "schema_version": 2,
  "model": "z-image-turbo",
  "operation": "image.generate",
  "inputs": [
    {
      "kind": "text",
      "role": "prompt",
      "text": "A red fox walking through fresh snow in a pine forest, soft morning sunlight, detailed photography."
    }
  ],
  "outputs": [
    {
      "kind": "image",
      "path": "${OUTPUT}",
      "width": 512,
      "height": 512
    }
  ],
  "sampling": {
    "seed": 42,
    "steps": 9
  },
  "execution": {
    "policy": "gpu",
    "streaming": {
      "schema_version": 2,
      "enabled": true,
      "selection": "memory_tier",
      "retention": "request",
      "target_request_memory_bytes": 10737418240
    }
  },
  "parameters": {
    "dynamic_text": true
  }
}

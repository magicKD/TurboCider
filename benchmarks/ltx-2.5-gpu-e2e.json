{
  "id": "ltx-2.5-gpu-worker-vs-turbocider-704x480-97f",
  "warmup_runs": 1,
  "runs": 1,
  "direct": {
    "kind": "command",
    "cwd": "${TURBOCIDER_ENGINES}/ltx-mac",
    "output": "${TURBOCIDER}/outputs/benchmark-ltx-direct-gpu.mp4",
    "sidecar": "{output_stem}.ltx-artifacts/turbocider.json",
    "engine_metric_path": "wall_seconds",
    "environment": {
      "LTX_MEDIA_BACKEND": "mlx",
      "LTX_MLX_MEDIA_WARMUP": "1"
    },
    "command": [
      "python3", "${TURBOCIDER}/src/turbocider/workers/ltx_pipeline.py",
      "--engine", "${TURBOCIDER_ENGINES}/ltx-mac/build/bench_block_mlx",
      "--ltx-root", "${TURBOCIDER_ENGINES}/ltx-mac",
      "--comfy-python", "${COMFYUI_PYTHON}",
      "--mlx-python", "${TURBOCIDER_ENGINES}/ltx-mac/.venv-mlx/bin/python",
      "--comfy-root", "${COMFYUI_ROOT}",
      "--text-encoder", "${LTX_TEXT_ENCODER}",
      "--transformer", "${LTX_TRANSFORMER}",
      "--upsampler", "${LTX_UPSAMPLER}",
      "--video-vae", "${LTX_VIDEO_VAE}",
      "--audio-vae", "${LTX_AUDIO_VAE}",
      "--conditioning", "${TURBOCIDER_ENGINES}/ltx-mac/outputs/conditioning/coastal_runner/connected",
      "--artifact-dir", "{output_stem}.ltx-artifacts",
      "--output", "{output}",
      "--prompt", "A cinematic red fox running through a snowy forest",
      "--width", "704", "--height", "480", "--frames", "97", "--fps", "24",
      "--seed", "42", "--dynamic-conditioning"
    ]
  },
  "turbocider": {
    "kind": "turbocider",
    "sidecar": "{output_stem}.ltx-artifacts/turbocider.json",
    "engine_metric_path": "engine_wall_seconds",
    "request": {
      "model": "ltx-2.5-distilled",
      "task": "video",
      "prompt": "A cinematic red fox running through a snowy forest",
      "output": {
        "type": "video",
        "path": "${TURBOCIDER}/outputs/benchmark-ltx-turbocider-gpu.mp4",
        "width": 704, "height": 480, "frames": 97, "fps": 24, "audio": true
      },
      "sampling": {"seed": 42, "steps": 11},
      "policy": {
        "execution": "gpu", "profile": "quality",
        "approximation": "exact", "persistent": false
      }
    }
  },
  "artifact_pairs": [
    {
      "name": "video_latent.bf16",
      "direct": "{direct_output_stem}.ltx-artifacts/video_latent.bf16",
      "turbocider": "{turbocider_output_stem}.ltx-artifacts/video_latent.bf16"
    },
    {
      "name": "audio_latent.bf16",
      "direct": "{direct_output_stem}.ltx-artifacts/audio_latent.bf16",
      "turbocider": "{turbocider_output_stem}.ltx-artifacts/audio_latent.bf16"
    },
    {
      "name": "video_pixels.bf16",
      "direct": "{direct_output_stem}.ltx-artifacts/video_pixels.bf16",
      "turbocider": "{turbocider_output_stem}.ltx-artifacts/video_pixels.bf16"
    }
  ],
  "metric_pairs": [
    {"name": "worker", "direct": "wall_seconds", "turbocider": "engine_wall_seconds"},
    {"name": "text conditioning", "direct": "phase_times.text_conditioning_seconds"},
    {"name": "connector", "direct": "phase_times.connector_seconds"},
    {"name": "native generation", "direct": "phase_times.native_generation_seconds"},
    {"name": "video encode", "direct": "phase_times.video_encode_seconds"},
    {"name": "audio finalize", "direct": "phase_times.audio_finalize_seconds"},
    {"name": "mux", "direct": "phase_times.mux_seconds"}
  ]
}

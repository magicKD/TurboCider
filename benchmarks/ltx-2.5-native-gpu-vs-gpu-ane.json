{
  "id": "ltx-2.5-native-gpu-vs-gpu-ane-704x480-97f",
  "warmup_runs": 1,
  "runs": 1,
  "comparison": {"kind": "artifacts"},
  "direct": {
    "kind": "command",
    "cwd": "${WORKSPACE}/ltx-mac",
    "output": "${TURBOCIDER}/outputs/benchmark-ltx-native-gpu",
    "output_kind": "directory",
    "sidecar": "{output}/generation.json",
    "engine_metric_regex": "two_stage_elapsed_seconds=([0-9]+(?:\\.[0-9]+)?)",
    "environment": {
      "LTX_OUTPUT_WIDTH": "704",
      "LTX_OUTPUT_HEIGHT": "480",
      "LTX_MEDIA_BACKEND": "mlx",
      "LTX_MLX_MEDIA_WARMUP": "1"
    },
    "command": [
      "${WORKSPACE}/ltx-mac/build/bench_block_mlx",
      "${HOME}/ComfyUI-Shared/models/diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "all", "--generate",
      "${HOME}/ComfyUI-Shared/models/latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "${HOME}/ComfyUI-Shared/models/vae/ltx-2.5-video-vae-conv-bf16.safetensors",
      "${WORKSPACE}/ltx-mac/outputs/conditioning/coastal_runner/connected",
      "{output}", "42"
    ]
  },
  "turbocider": {
    "kind": "command",
    "cwd": "${WORKSPACE}/ltx-mac",
    "output": "${TURBOCIDER}/outputs/benchmark-ltx-native-gpu-ane",
    "output_kind": "directory",
    "sidecar": "{output}/generation.json",
    "engine_metric_regex": "two_stage_elapsed_seconds=([0-9]+(?:\\.[0-9]+)?)",
    "environment": {
      "LTX_OUTPUT_WIDTH": "704",
      "LTX_OUTPUT_HEIGHT": "480",
      "LTX_MEDIA_BACKEND": "mlx",
      "LTX_MLX_MEDIA_WARMUP": "1",
      "LTX_AV_PARALLEL_GPU": "1",
      "LTX_ANE_MLP_STAGE1_DIR": "${WORKSPACE}/ltx-mac/models/coreml/ltx_mlp_a6912_int8_samples/stage1",
      "LTX_ANE_MLP_STAGE2_DIR": "${WORKSPACE}/ltx-mac/models/coreml/ltx_mlp_a6912_int8_samples/stage2",
      "LTX_ANE_MLP_VARIANT": "int8_pc",
      "LTX_ANE_MLP_RELEASE_FULL_GPU": "1",
      "LTX_ANE_KV_DIR": "${WORKSPACE}/ltx-mac/models/coreml/ltx_text_kv_all48_int8",
      "LTX_ANE_KV_VARIANT": "int8_pc",
      "LTX_ANE_KV_STAGE1": "1",
      "LTX_ANE_KV_STAGE2": "0"
    },
    "command": [
      "${WORKSPACE}/ltx-mac/build/bench_block_mlx_ane",
      "${HOME}/ComfyUI-Shared/models/diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "all", "--generate",
      "${HOME}/ComfyUI-Shared/models/latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "${HOME}/ComfyUI-Shared/models/vae/ltx-2.5-video-vae-conv-bf16.safetensors",
      "${WORKSPACE}/ltx-mac/outputs/conditioning/coastal_runner/connected",
      "{output}", "42"
    ]
  },
  "artifact_pairs": [
    {
      "name": "video_latent.bf16",
      "direct": "{direct_output}/video_latent.bf16",
      "turbocider": "{turbocider_output}/video_latent.bf16",
      "comparison": {
        "command": [
          "${WORKSPACE}/ltx-mac/.venv-mlx/bin/python",
          "${WORKSPACE}/ltx-mac/tools/compare_bf16.py",
          "{direct_artifact}", "{turbocider_artifact}"
        ],
        "metric_regexes": {
          "rel_l2": "rel_l2=([0-9.eE+-]+)",
          "cosine": "cosine=([0-9.eE+-]+)",
          "rms_ratio": "rms_ratio=([0-9.eE+-]+)",
          "rmse": "rmse=([0-9.eE+-]+)",
          "max_abs": "max_abs=([0-9.eE+-]+)"
        }
      }
    },
    {
      "name": "audio_latent.bf16",
      "direct": "{direct_output}/audio_latent.bf16",
      "turbocider": "{turbocider_output}/audio_latent.bf16",
      "comparison": {
        "command": [
          "${WORKSPACE}/ltx-mac/.venv-mlx/bin/python",
          "${WORKSPACE}/ltx-mac/tools/compare_bf16.py",
          "{direct_artifact}", "{turbocider_artifact}"
        ],
        "metric_regexes": {
          "rel_l2": "rel_l2=([0-9.eE+-]+)",
          "cosine": "cosine=([0-9.eE+-]+)",
          "rms_ratio": "rms_ratio=([0-9.eE+-]+)",
          "rmse": "rmse=([0-9.eE+-]+)",
          "max_abs": "max_abs=([0-9.eE+-]+)"
        }
      }
    },
    {
      "name": "video_pixels.bf16",
      "direct": "{direct_output}/video_pixels.bf16",
      "turbocider": "{turbocider_output}/video_pixels.bf16",
      "comparison": {
        "command": [
          "${WORKSPACE}/ltx-mac/.venv-mlx/bin/python",
          "${WORKSPACE}/ltx-mac/tools/compare_bf16.py",
          "{direct_artifact}", "{turbocider_artifact}"
        ],
        "metric_regexes": {
          "rel_l2": "rel_l2=([0-9.eE+-]+)",
          "cosine": "cosine=([0-9.eE+-]+)",
          "rms_ratio": "rms_ratio=([0-9.eE+-]+)",
          "rmse": "rmse=([0-9.eE+-]+)",
          "max_abs": "max_abs=([0-9.eE+-]+)"
        }
      }
    }
  ]
}

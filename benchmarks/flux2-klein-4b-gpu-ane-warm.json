{
  "id": "flux2-klein-4b-gpu-ane-compiled-512-4step",
  "warmup_runs": 1,
  "runs": 1,
  "direct": {
    "kind": "batch-command",
    "cwd": "${WORKSPACE}/gpu_ane/flux2-engine",
    "environment": {
      "PYTHONPATH": "${WORKSPACE}/gpu_ane/flux2-engine/src:${WORKSPACE}/gpu_ane/mflux-runtime/src"
    },
    "output_dir": "${TURBOCIDER}/outputs/benchmark-flux2-direct-hybrid",
    "report": "${TURBOCIDER}/outputs/benchmark-flux2-direct-hybrid.json",
    "command": [
      "${WORKSPACE}/gpu_ane/flux2-runtime/.venv/bin/python",
      "scripts/benchmark_engine.py",
      "A cider press in an orchard",
      "--model", "${WORKSPACE}/gpu_ane/flux2-runtime/models/FLUX.2-klein-4B",
      "--mflux-root", "${WORKSPACE}/gpu_ane/mflux-runtime",
      "--mode", "mlx-ane",
      "--ane-manifest", "${WORKSPACE}/gpu_ane/flux2-runtime/models/coreml/flux2_stack_runtime_m1088/compiled/manifest.json",
      "--output-dir", "{output_dir}",
      "--repeats", "{total_runs}",
      "--json", "{report}",
      "--width", "512", "--height", "512",
      "--steps", "4", "--seed", "42"
    ]
  },
  "turbocider": {
    "kind": "turbocider",
    "environment": {
      "FLUX2_ANE_MANIFESTS": "${WORKSPACE}/gpu_ane/flux2-runtime/models/coreml/flux2_stack_runtime_m1088/compiled/manifest.json"
    },
    "request": {
      "model": "flux2-klein-4b",
      "task": "image",
      "prompt": "A cider press in an orchard",
      "output": {
        "type": "image",
        "path": "${TURBOCIDER}/outputs/benchmark-flux2-turbocider-hybrid.png",
        "width": 512,
        "height": 512,
        "frames": 1,
        "fps": 24
      },
      "sampling": {"seed": 42, "steps": 4, "guidance": 1.0},
      "policy": {
        "execution": "gpu_ane",
        "profile": "quality",
        "approximation": "validated",
        "persistent": true
      }
    }
  }
}

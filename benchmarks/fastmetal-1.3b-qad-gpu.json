{
  "id": "fastmetal-1.3b-qad-gpu-832x480x81",
  "warmup_runs": 0,
  "runs": 1,
  "direct": {
    "kind": "command",
    "cwd": "${TURBOCIDER_ENGINES}/fastmetal/engine",
    "output": "${TURBOCIDER}/outputs/benchmark-fastmetal-direct-gpu.mp4",
    "sidecar": "{output_stem}.engine.json",
    "engine_metric_path": "total_s",
    "command": [
      "${TURBOCIDER_ENGINES}/fastmetal/runtime/.venv/bin/python",
      "examples/inference/basic/mlx_wan_prompt_to_video.py",
      "--model-root", "${TURBOCIDER_ENGINES}/fastmetal/runtime/models/FastMetal-1.3B-QAD",
      "--mlx-checkpoint", "${TURBOCIDER_ENGINES}/fastmetal/runtime/models/FastMetal-1.3B-QAD",
      "--prompt", "A bird's-eye view of a misty forest valley at dawn.",
      "--output-path", "{output}",
      "--metrics-json", "{output_stem}.engine.json",
      "--height", "480", "--width", "832", "--num-frames", "81", "--fps", "16",
      "--seed", "1024", "--denoising-mode", "dmd",
      "--dmd-denoising-steps", "1000,757,522",
      "--mlx-dtype", "fp16", "--mlx-quantization", "int8", "--mlx-compile",
      "--decode-backend", "taehv", "--text-encoder-dtype", "bf16",
      "--save-latents"
    ]
  },
  "turbocider": {
    "kind": "turbocider",
    "output": "${TURBOCIDER}/outputs/benchmark-fastmetal-turbocider-gpu.mp4",
    "request": {
      "model": "fastmetal-1.3b-qad",
      "task": "video",
      "prompt": "A bird's-eye view of a misty forest valley at dawn.",
      "output": {
        "type": "video",
        "path": "${TURBOCIDER}/outputs/benchmark-fastmetal-turbocider-gpu.mp4",
        "width": 832, "height": 480, "frames": 81, "fps": 16, "audio": false
      },
      "sampling": {"seed": 1024, "steps": 3},
      "policy": {
        "execution": "gpu", "profile": "quality",
        "approximation": "exact", "persistent": false
      },
      "engine_options": {"fastmetal": {"args": ["--save-latents"]}}
    }
  },
  "artifact_pairs": [
    {
      "name": "denoised_latents",
      "direct": "{direct_output_stem}.latents.npy",
      "turbocider": "{turbocider_output_stem}.latents.npy"
    }
  ]
}

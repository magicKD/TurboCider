{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbocider.local/schemas/model-pack.schema.json",
  "title": "TurboCider model pack",
  "type": "object",
  "required": ["id", "name", "engine", "capabilities", "plans"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "name": {"type": "string"},
    "engine": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "description": "Built-in engine id or an installed turbocider.adapters entry point"
    },
    "version": {"type": "string"},
    "capabilities": {"type": "object"},
    "config": {"type": "object"},
    "preparation": {"type": "object"},
    "plans": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": false
}

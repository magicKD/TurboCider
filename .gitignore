# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors and IDE user state
.idea/
.vscode/
*.swp
*.swo
*~
*.xcuserstate
xcuserdata/

# Swift / Xcode
/.build/
/.swiftpm/
/DerivedData/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Python environments and packaging
.venv/
venv/
env/
ENV/
/build/
/dist/
*.egg-info/
pip-wheel-metadata/

# Native compiler/linker output, including out-of-tree experimental builds
*.o
*.a
*.dylib
*.so
*.air
*.metallib
*.dSYM/

# Local configuration and credentials
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.mobileprovision

# Logs, temporary files, and local databases
*.log
*.tmp
*.temp
*.pid
*.sqlite
*.sqlite3
*.db

# TurboCider generated artifacts and runtime state
/outputs/
/artifacts/
/state/
/runtime.json
/models/
/Python/
/.deps/

# Local research notes. Stable, path-sanitized conclusions belong in docs/.
/notes/

# Local monorepo/workspace pointer, only used while developing TurboCider
# alongside the other native engine repositories.
/workspace.path

# Machine-specific overrides; keep portable *.example.json profiles tracked
/profiles/*.local.json

# Keep curated validation evidence tracked; raw runs belong in /outputs/.
/docs/design/validation/local/
/docs/design/validation/raw/
/docs/design/validation/*.raw.json

# Downloaded model weights and compiled model caches
*.safetensors
*.ckpt
*.pth
*.onnx
*.gguf
*.mlmodel
*.mlpackage/
*.mlmodelc/

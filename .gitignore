# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors and IDE user state
.idea/
.vscode/
*.swp
*.swo
*~
*.xcuserstate
xcuserdata/

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
*.xcresult/
*.xcarchive/

# Raw GPU / Instruments captures can contain buffers and machine-local paths.
# Keep portable profiling summaries and source code trackable.
*.gputrace
*.gputrace.zip
*.trace
*.trace.zip

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.cache/
# Optional ANEForge experiments can create caches beside any caller's source.
.aneforge_cache/
.aneforge-cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Python environments and packaging
.venv/
venv/
env/
ENV/
/build/
/dist/
*.egg-info/
pip-wheel-metadata/

# Native compiler/linker output, including out-of-tree experimental builds
*.o
*.a
*.dylib
*.so
*.air
*.metallib
*.dSYM/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# Local configuration and credentials
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.mobileprovision

# Logs, temporary files, and local databases
*.log
*.tmp
*.temp
*.pid
*.sqlite
*.sqlite3
*.db
# Root-local LMDB runtime cache; keep any intentional database fixtures trackable.
/data.mdb
/lock.mdb

# TurboCider generated artifacts and runtime state
/outputs/
/results/qwen21/
# Local Z-Image benchmark requests, images, exports and compile identities.
# Portable requests belong in examples/requests; conclusions belong in docs/.
/results/z-image-*
/artifacts/
/state/
/runtime.json
/models/
/Python/
/.deps/

# Local research notes. Stable, path-sanitized conclusions belong in docs/.
/notes/

# Local experiment records and future runs; keep summaries in docs/.
/local-experiments/

# Local monorepo/workspace pointer, only used while developing TurboCider
# alongside the other native engine repositories.
/workspace.path

# Machine-specific overrides; keep portable *.example.json profiles tracked
/profiles/*.local.json

# Keep curated validation evidence tracked; raw runs belong in /outputs/.
/docs/design/validation/local/
/docs/design/validation/raw/
/docs/design/validation/*.raw.json

# techniques is a lightweight knowledge base, not an experiment archive.
# Data must stay outside it even if described as curated or historical.
/techniques/**/*.json
/techniques/**/*.jsonl
/techniques/**/*.ndjson
/techniques/**/*.json.gz
/techniques/**/*.jsonl.gz
/techniques/**/*.npy
/techniques/**/*.npz
/techniques/**/build/
/techniques/**/dist/
/techniques/**/outputs/
/techniques/**/results/
/techniques/**/artifacts/
/techniques/**/scratch/
/techniques/**/private/
/techniques/**/raw/
/techniques/**/intermediate/
/techniques/**/check-results/
/techniques/**/evidence/
/techniques/**/records/
/techniques/**/archive/
/techniques/labs/
/techniques/integrations/
/techniques/tests/
/techniques/data/
/techniques/candidates/
/techniques/review/

# Downloaded model weights and compiled model caches
*.safetensors
# Lossless BF16 activation/reference archives from optional research clients.
# Curated JSON evidence and tiny portable tensor fixtures remain trackable.
*.tcbf16z
*.ckpt
*.pth
*.onnx
*.gguf
*.mlmodel
*.mlpackage/
*.mlmodelc/

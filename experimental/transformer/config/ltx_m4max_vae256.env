# Experimental M4 Max preset, measured 2026-09-14 at 704x448 / 97 frames.
# Source this file explicitly before an LTX request or benchmark.
# This changes spatial VAE decoding; it is NOT pixel-exact to untiled decoding.
# It does not enable approximate attention or choose GPU versus GPU/ANE.
# Other resolutions/prompts require separate performance and quality checks.
export TURBOCIDER_LTX_VAE_TILED=1
export TURBOCIDER_LTX_VAE_TILE_PIXELS=256
export TURBOCIDER_LTX_VAE_TILE_OVERLAP_PIXELS=64

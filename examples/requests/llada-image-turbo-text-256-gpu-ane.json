{
  "schema_version": 2,
  "model": "llada-image-turbo",
  "operation": "image.generate",
  "inputs": [
    {
      "kind": "text",
      "role": "prompt",
      "text": "A red fox in fresh snow, cinematic photograph"
    }
  ],
  "outputs": [
    {
      "kind": "image",
      "path": "/tmp/turbocider-llada-text-256-gpu-ane.png",
      "width": 256,
      "height": 256,
      "frames": 1
    }
  ],
  "sampling": {
    "seed": 42,
    "steps": 4
  },
  "execution": {
    "policy": "gpu_ane",
    "ane_manifest": "/absolute/path/to/compiled-cache/manifest.json",
    "allow_approximation": true,
    "residency": "resident"
  }
}

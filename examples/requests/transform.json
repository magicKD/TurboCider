{
  "schema_version": 2,
  "model": "flux2-klein-4b",
  "operation": "image.transform",
  "inputs": [
    {
      "kind": "text",
      "role": "prompt",
      "text": "A red fox in a snowy forest, soft morning light."
    },
    {
      "kind": "image",
      "role": "init_image",
      "path": "/absolute/reference.png",
      "strength": 0.5
    }
  ],
  "outputs": [
    {
      "kind": "image",
      "path": "/tmp/turbocider-result.png",
      "width": 512,
      "height": 512
    }
  ],
  "sampling": {
    "seed": 42,
    "steps": 4
  },
  "execution": {
    "policy": "gpu",
    "residency": "resident"
  }
}
